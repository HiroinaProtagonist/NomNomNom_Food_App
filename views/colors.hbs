<h1>Colors</h1>

{{! READ table }}
<table>
    <thead>
        {{! HEADER }}
        <tr>
            {{#each color.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
        </tr>
    </thead>

    <tbody>
        {{! FIELDS }}
        {{#each color}}
        <tr>
            <td>{{this.COLOR_ID}}</td>
            <td>{{this.COLOR}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>
