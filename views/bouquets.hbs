<h1>Bouquets</h1>

{{! READ table }}
<table>
    <thead>
    {{! Headers }}
    <tr>
        {{#each bouquets.[0]}}
            <th>
                {{@key}}
            </th>
        {{/each}}
        <th></th>
        <th></th>
    </tr>
    </thead>

    <tbody>
    {{! Fields }}
    {{#each bouquets}}
        <tr>
            <td>{{this.NUMBER}}</td>
            <td>{{this.BOUQUET}}</td>
            <td>{{this.DESCRIPTION}}</td>
            <td>{{this.MAKER}}</td>
            <td>{{this.RECIPIENT}}</td>

            {{! UPDATE form }}
            <form id='update_bouquet_form' METHOD='POST' action='/bouquet_edit'>
                <input type='hidden' name='update_bouquet_id' value='{{this.NUMBER}}'/>
                <input type='hidden' name='update_bouquet_name' value='{{this.BOUQUET}}' />
                <input type='hidden' name='update_bouquet_description' value='{{this.DESCRIPTION}}' />
                <input type='hidden' name='update_maker_id' value='{{this.MAKER}}' />
                <input type='hidden' name='update_recipient_id' value='{{this.RECIPIENT}}' />
                <td>
                    <button type='submit'>
                        Edit
                    </button>
                </td>
            </form>

            {{! DELETE form }}
            <form id='delete_bouquet_form' METHOD='POST' action='/bouquets/delete'>
                <input type='hidden' name='delete_bouquet_id' value='{{this.NUMBER}}'/>
                <input type='hidden' name='delete_bouquet_name' value='{{this.BOUQUET}}'/>
                <td>
                    <button type='submit'>
                        Delete
                    </button>
                </td>
            </form>
        </tr>
    {{/each}}

    <tr><td colspan='7'>&nbsp;</td></tr>

    <form class='cuForm' id='create_flower_form' METHOD='POST' action='/bouquets/create'>
        <tr>
            <td>Add New</td>
            <td><input type='text' name='create_bouquet_name' id='create_bouquet_name' required/></td>
            <td><input type='text' name='create_bouquet_description' id='create_bouquet_description' required/></td>
            <td><select name='create_maker_id' id='create_maker_id' required>
                <option value='NULL' disabled selected>Select a Maker</option>
                {{#each makers}}
                    <option value='{{this.MAKER_ID}}' required>{{this.MAKER_ID}}-{{this.NAME}}</option>
                {{/each}}
            </select></td>
            <td><select name='create_recipient_id' id='create_recipient_id'>
                <option value='NULL' disabled selected>Select a Recipient</option>
                {{#each recipients}}
                    <option value='{{this.RECIPIENT_ID}}' required>{{this.RECIPIENT_ID}}-{{this.NAME}}</option>
                {{/each}}
            </select>
            </td>
            <td colspan="2"><input type='submit'/></td>
        </tr>
    </form>

    </tbody>
</table>
</br>

