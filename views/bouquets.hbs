<h1>Bouquets</h1>

{{! READ table }}
<table>
    <thead>
        {{! Headers }}
        <tr>
            {{#each bouquet.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
        </tr>
    </thead>

    <tbody>
        {{! Fields }}
        {{#each bouquet}}
        <tr>
            <td>{{this.BOUQUET_ID}}</td>
            <td>{{this.BOUQUET}}</td>
            <td>{{this.DESCRIPTION}}</td>
            <td>{{this.FLOWER_ID}}</td>
            <td>{{this.FLOWER}}</td>
            <td>{{this.MAKER}}</td>
            <td>{{this.RECIPIENT}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>

{{!-- Removed CREATE, do not need for M:M and already have on Food Items page --}}

