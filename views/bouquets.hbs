<h1>Orders</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each order.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the id, fname, lname, homeworld and age }}
        {{#each order}}
        <tr>
            <td>{{this.NUMBER}}</td>
            <td>{{this.DATE}}</td>
            <td>{{this.CUSTOMER}}</td>
            <td>{{this.RESTAURANT}}</td>
            <td>{{this.FOOD}}</td>
            <td>{{this.PRICE}}</td>
            <td>{{this.TOTAL}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>

{{!-- Removed CREATE, do not need for M:M and already have on Food Items page --}}

{{! UPDATE form }}
</br>
<h2>Update an Order's Details</h2>
<form class='cuForm' id='update_order_id_form' method='POST' action='/food_items_orders/update'>
    <label for='update_order_id'>Order to Update: </label>
    <select name='update_order_id' id='update_order_id' required>
        <option value='' disabled selected>Order Number</option>
        {{#each orders}}
        <option value='{{this.ORDER_ID}}' required>
            {{this.ORDER_ID}}
        </option>
        {{/each}}
    </select>

    <label for='update_food_item_id'>Food Item to Update: </label>
    <select name='update_food_item_id' id='update_food_item_id'>
        <option value='' disabled selected>Food Item</option>
        <!-- Should be distinct values - ie Ribs only once?-->
        {{#each foods}}
        <option value='{{this.FOOD_ITEM_ID}}' required>
            {{this.NAME}}
        </option>
        {{/each}}
    </select>

    <label for='update_order_food_item_quantity'>Quantity: </label>
    <input type='number' name='update_quantity' id='update_quantity' min='1' />

    <input type='submit' />
</form>