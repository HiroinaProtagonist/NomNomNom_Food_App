<h1>Restaurants</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each restaurant.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the id, fname, lname, homeworld and age }}
        {{#each restaurant}}
        <tr>
            <td>{{this.NAME}}</td>
            <td>{{this.RATING}}</td>
            <td>{{this.PHONE}}</td>
            <td>{{this.ADDRESS}}</td>
            <td>{{this.EMAIL}}</td>

            {{!-- Took out since our delete is on Food Items and Orders pages --}}
            {{! DELETE form }}
            {{!-- <form id='delete_person_form'>
                <input type='hidden' name='delete_person_id' value='{{this.id}}' />
                <input type='hidden' name='delete_person_name' value='{{this.fname}} {{this.lname}}' />
                <td>
                    <button type='submit'>
                        Delete
                    </button>
                </td>
            </form> --}}
        </tr>
        {{/each}}
    </tbody>
</table>

