<h1>Edit a Bouquet</h1>
<table>
    <thead>
    <tr>
        <th><label for='bouquet_name'>Name </label></th>
        <th><label for='bouquet_description'>Description </label></th>
        <th><label for='maker_id'>Maker </label></th>
        <th><label for='recipient_id'>Recipient </label></th>
        <form class='cuForm' id='bouquet_return_form' METHOD='GET' action='/bouquets'>
            <th><input type='submit' value='Return to Bouquets'/></th>
        </form>
    </tr>
    </thead>
    <tbody>
    <form class='cuForm' id='update_bouquet_form' METHOD='POST' action='/bouquets/update'>
        <tr>
            <td><input type='text' name='bouquet_name'
                       id='bouquet_name' value='{{data.bouquet_name}}' required/><br/></td>

            <td><input type='text' name='bouquet_description'
                       id='bouquet_description' value='{{data.bouquet_description}}' required/><br/></td>

            <td><select name='maker_id' id='maker_id'>
                <option value='NULL' disabled selected>Select a Maker</option>
                {{#each makers}}
                    <option value='{{this.MAKER_ID}}'
                        {{#if (shouldBeSelectedMaker this.NAME)}}
                            selected
                        {{/if}}
                            required>{{this.MAKER_ID}}-{{this.NAME}}</option>
                {{/each}}
            </select></td>

            <td><select name='recipient_id' id='recipient_id'>
                <option value='NULL' disabled selected>Select a Recipient</option>
                <option value='NULL' }}></option>
                {{#each recipients}}
                    <option value='{{this.RECIPIENT_ID}}'
                        {{#if (shouldBeSelectedRecipient this.NAME)}}
                            selected
                        {{/if}}
                            required>{{this.RECIPIENT_ID}}-{{this.NAME}}</option>
                {{/each}}
            </select></td>
            <td>
                <input type='submit' value='Update Bouquet'/>
            </td>
        </tr>
        <input type='hidden' name='bouquet_id' value='{{data.bouquet_id}}'/>
    </form>

    <form class='cuForm' id='add_bouquet_flower_form' METHOD='POST' action='/bouquet_flower_add'>
        <tr>
            <td colspan="5">&nbsp;</td>
        </tr>
        {{! ADD FLOWER Form }}
        <tr>
            <input type='hidden' name='bouquet_id' value='{{data.bouquet_id}}'/>
            <input type='hidden' name='bouquet_name' value='{{data.bouquet_name}}'/>
            <input type='hidden' name='bouquet_description' value='{{data.bouquet_description}}'/>
            <input type='hidden' name='maker_id' value='{{data.maker_id}}'/>
            <input type='hidden' name='recipient_id' value='{{data.recipient_id}}'/>
            <td><label for='add_bouquet_flower_id'><b>Manage {{data.bouquet_name}}'s Flowers: </b></label></td>

            {{! Possible to do multiple, but not aesthetic }}
            <td colspan="3">
                <select name='add_bouquet_flower_id' id='add_bouquet_flower_id'>
                    <option value='NULL' disabled selected>Add Flower to Bouquet</option>
                    {{#each flowers}}
                        <option value='{{this.FLOWER_ID}}'>
                            {{this.FLOWER_ID}}: {{this.COLOR}} {{this.NAME}}, {{this.MEANING}}
                        </option>
                    {{/each}}
                </select>
            </td>
            <td>
                <input type='submit' value="Add Flower to Bouquet"/>
            </td>
        </tr>
        {{#if (headerNeeded fbflowers)}}
            <tr>
                <td>Flower</td><td colspan="2">Meaning</td><td>&nbsp;</td><td>&nbsp;</td>
            </tr>
        {{/if}}
    </form>





    {{#each fbflowers}}
        <tr>
            {{! Redirects to edit flower with data }}
            <form class='cuForm' id='update_bouquet_flower_form' METHOD='POST' action='/flower_edit'>
                <input type='hidden' name='update_flower_id' value='{{this.FLOWER_ID}}'/>
                <input type='hidden' name='update_flower_name' value='{{this.NAME}}'/>
                <input type='hidden' name='update_flower_meaning' value='{{this.MEANING}}'/>
                <input type='hidden' name='update_flower_color' value='{{this.COLOR}}'/>
                <td>{{this.FLOWER_ID}}: {{this.COLOR}} {{this.NAME}}</td>
                <td colspan="2">{{this.MEANING}}</td>
                <td><input type='submit' value='Edit Flower'/></td>
            </form>

            {{! DELETE form }}
            <form class='cuForm' id='delete_bouquet_flower_form' METHOD='POST' action='/bouquet_flower_delete'>
                <!-- Variable access outside parent scope referenced from -->
                <!-- source url: https://stackoverflow.com/a/13645315/11312977 -->
                <input type='hidden' name='bouquet_id' value='{{../data.bouquet_id}}'/>
                <input type='hidden' name='flower_id' value='{{this.FLOWER_ID}}'/>
                <input type='hidden' name='bouquet_name' value='{{../data.bouquet_name}}'/>
                <input type='hidden' name='bouquet_description' value='{{../data.bouquet_description}}'/>
                <input type='hidden' name='maker_id' value='{{../data.maker_id}}'/>
                <input type='hidden' name='recipient_id' value='{{../data.recipient_id}}'/>
                <td><input type='submit' value='Remove from Bouquet'/></td>
            </form>
        </tr>
    {{/each}}
    </tbody>
</table>
