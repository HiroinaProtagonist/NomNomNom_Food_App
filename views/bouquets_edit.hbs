<h1>Bouquets</h1>

{{! UPDATE form }}
<h2>Update a Bouquet</h2>
<form class='cuForm' id='update_bouquet_form' METHOD='POST' action='/bouquets/update'>
    <table id="update_bouquet_form_table">
        <tr>
            <!--    <td>-->
            <!--    <span id="left_bouquet_form">-->
            <td><label for='update_bouquet_name'>Name: </label></td>
            <td><input type='text' name='update_bouquet_name' id='update_bouquet_name' required/><br/></td>
            <!--    </tr>-->
            <!--        <tr>-->
            <td rowspan="4">
                <!--    </span>-->
                <!--    <span id="right_bouquet_form"><br/>-->
                <label for='update_bouquet_flowers'>Flowers: </label>
                <br/></td>
            <td rowspan="4">

                <select name='update_bouquet_flowers' id='update_bouquet_flowers' multiple>
                    <option value='NULL' disabled selected>Select Flowers</option>
                    {{#each flowers}}
                        <option value='{{this.FLOWER_ID}}' required>{{this.FLOWER_ID}}
                            : {{this.COLOR}} {{this.NAME}}</option>
                    {{/each}}
                </select>
                <!--    </span>-->
            </td>

        <tr>
            <td><label for='update_bouquet_description'>Description: </label></td>
            <td><input type='text' name='update_bouquet_description' id='update_bouquet_description' required/>
                <br/></td>
        </tr>
        <tr>
            <td><label for='update_maker_id'>Maker: </label></td>
            <td><select name='update_maker_id' id='update_maker_id'>
                <option value='NULL' disabled selected>Select a Maker</option>
                {{#each makers}}
                    <option value='{{this.MAKER_ID}}' required>{{this.MAKER_ID}}-{{this.NAME}}</option>
                {{/each}}
            </select>
                <br/></td>
        </tr>
        <tr>
            <td><label for='update_recipient_id'>Recipient: </label></td>
            <td><select name='update_recipient_id' id='update_recipient_id'>
                <option value='NULL' disabled selected>Select a Recipient</option>
                {{#each recipients}}
                    <option value='{{this.RECIPIENT_ID}}' required>{{this.RECIPIENT_ID}}-{{this.NAME}}</option>
                {{/each}}
            </select>
            </td>
        </tr>
    </table>
    <br/>
    <input type='submit'/>
</form>