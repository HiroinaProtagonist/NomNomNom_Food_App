<h1>Edit a Bouquet</h1>
    <table id="update_bouquet_form_table">
        <tr>
            <td><label for='update_bouquet_name'>Name </label></td>
            <td><label for='update_bouquet_description'>Description </label></td>
            <td><label for='update_maker_id'>Maker </label></td>
            <td><label for='update_recipient_id'>Recipient </label></td>
            <form class='cuForm' id='bouquet_return_form' METHOD='GET' action='/bouquets'>
                <td><input type='submit' value='Return to Bouquets'/></td>
            </form>
        </tr>

        <form class='cuForm' id='update_bouquet_form' METHOD='POST' action='/bouquets/update'>
        <tr>
            <td><input type='text' name='update_bouquet_name'
                       id='update_bouquet_name' value='{{data.update_bouquet_name}}' required/><br/></td>

            <td><input type='text' name='update_bouquet_description'
                       id='update_bouquet_description' value='{{data.update_bouquet_description}}' required/><br/></td>

            <td><select name='update_maker_id' id='update_maker_id'>
                <option value='NULL' disabled selected>Select a Maker</option>
                {{#each makers}}
                    <option value='{{this.MAKER_ID}}'
                        {{#if (shouldBeSelectedMaker this.NAME)}}
                            selected
                        {{/if}}
                            required>{{this.MAKER_ID}}-{{this.NAME}}</option>
                {{/each}}
            </select></td>

            <td><select name='update_recipient_id' id='update_recipient_id'>
                <option value='NULL' disabled selected>Select a Recipient</option>
                {{#each recipients}}
                    <option value='{{this.RECIPIENT_ID}}'
                        {{#if (shouldBeSelectedRecipient this.NAME)}}
                            selected
                        {{/if}}
                            required>{{this.RECIPIENT_ID}}-{{this.NAME}}</option>
                {{/each}}
            </select></td>
            <td>
<!--                <input type='submit' value='Update Bouquet'/>-->
            </td>
        </tr>
            <input type='hidden' name='update_select_bouquet_id' value='{{data.update_bouquet_id}}'/>
<!--        </form>-->

        <tr><td colspan="5">&nbsp;</td></tr>
<!--        <form class='cuForm' id='create_flower_form' METHOD='POST' action='/bouquet/flower/create'>-->
            <tr><td><label for='update_bouquet_flowers'>Flowers: </label></td>
                <td colspan="4"></td>
            </tr>
            <tr>
                <td><select name='update_bouquet_flowers' id='update_bouquet_flowers' required multiple>
                    <option value='NULL' disabled selected>Select Flowers</option>
                    {{#each flowers}}
                        <option value='{{this.FLOWER_ID}}'
                            {{#if (shouldBeSelectedFlower this.FLOWER_ID)}}
                                selected
                            {{/if}}
                        >{{this.FLOWER_ID}}: {{this.COLOR}} {{this.NAME}}</option>
                    {{/each}}
                </select></td>
                <td colspan="4"></td>
            <tr><td colspan="4">&nbsp;</td><td><input type='submit' value='Update Bouquet'/></td></tr>
            </tr>
        </form>
    </table>



