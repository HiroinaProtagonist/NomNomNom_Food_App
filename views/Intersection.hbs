<h1>Intersection Table</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each intersection.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the fields }}
        {{#each intersection}}
        <tr>
            <td>{{this.ORDER_ID}}</td>
            <td>{{this.FOOD_ITEM_ID}}</td>
            <td>{{this.NAME}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>
