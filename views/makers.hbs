<h1>Senders</h1>

{{! READ table }}
<table>
    <thead>
    {{! Print DB attribute names for the table header row }}
    <tr>
        {{#each sender.[0]}}
            <th>
                {{@key}}
            </th>
        {{/each}}
    </tr>
    </thead>

    <tbody>
    {{#each sender}}
        <tr>
            <td>{{this.NAME}}</td>
            <td>{{this.PHONE}}</td>
            <td>{{this.ADDRESS}}</td>
            <td>{{this.EMAIL}}</td>
        </tr>
    {{/each}}
    </tbody>
</table>