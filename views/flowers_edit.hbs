<h1>Flowers</h1>

{{! UPDATE form }}
<h2>Edit a flower</h2>
<form class='cuForm' id='update_flower_form' METHOD='POST' action='/flowers/update'>
    <table id="update_flower_form_table">
        <tr>
            <td><label for='update_flower_name'>Name: </label></td>
            <td><input type='text' name='update_flower_name'
                       id='update_flower_name' value='{{data.update_flower_name}}' required/><br/></td>
            <td><label for='update_flower_color'>Color: </label></td>
            <form class='cuForm' id='flower_return_form' METHOD='GET' action='/flowers'>
                <td><input type='submit' value='Return to Flowers'/></td>
            </form>
        </tr>

        <tr>
            <td><label for='update_flower_description'>Description: </label></td>
            <td><input type='text' name='update_flower_meaning'
                       id='update_flower_meaning' value='{{data.update_flower_meaning}}' required/><br/></td>
            <td>
                <select name='update_flower_color' id='update_flower_color'>
                    <option value='NULL' disabled>Select Color</option>
                    {{#each colors}}
                        <option value='{{this.COLOR_ID}}'
                            {{#if (shouldBeSelected this.COLOR)}}
                                selected
                            {{/if}}
                        required>{{this.COLOR_ID}}: {{this.COLOR}}</option>
                    {{/each}}
                </select>
            </td>
            <td></td>
        </tr>

        <tr>
            <td colspan="3"></td>
            <td><input type='submit' value="Update Flower"/></td>
        </tr>
    </table>
    <br/>
    <input type='hidden' name='update_select_flower_id' value='{{data.update_flower_id}}' />
</form>