<h1>Food Items</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each food.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{#each food}}
        <tr>
            <td>{{this.RESTAURANT_ID}}</td>
            <td>{{this.RESTAURANT}}</td>
            <td>{{this.FOOD_ITEM_ID}}</td>
            <td>{{this.FOOD}}</td>
            <td>{{this.PRICE}}</td>

            {{! DELETE form }}
            <form id='delete_food_item_form' METHOD='POST' action='/food_items/delete'>
                <input type='hidden' name='delete_food_item_id' value='{{this.FOOD_ITEM_ID}}' />
                <input type='hidden' name='delete_food_item_name' value='{{this.FOOD}}' />
                <input type='hidden' name='delete_restaurant_id' value='{{this.RESTAURANT_ID}}' />
                <td>
                    <button type='submit'>
                        Delete
                    </button>
                </td>
            </form>
        </tr>
        {{/each}}
    </tbody>
</table>

{{! CREATE form }}
</br>
<h2>Create a New Food Item</h2>
<form class='cuForm' id='create_food_item_form' METHOD='POST' action='/food_items/create'>
    <label for='create_food_item_name'>Name: </label>
    <input type='text' name='create_food_item_name' id='create_food_item_name' required />

    <label for='create_food_item_price'>Price: </label>
    <!-- Citation for the step field in the following control. Date: 3/6/2026
         Developed with reference to:
         Source URL: https://amydegregorio.com/2017/11/22/html5-number-input-the-step-attribute/ -->
    <input type='number' step=".01" name='create_food_item_price' id='create_food_item_price' min='0' />

    <label for='create_food_item_restaurant_id'>Restaurant: </label>
    <select name='create_food_item_restaurant_id' id='create_food_item_restaurant_id'>
        <option value='NULL' disabled selected>Select a Restaurant</option>
<!--        <option value='NULL'>&lt; None &gt;</option>-->
        {{#each restaurant}}
        <option value='{{this.RESTAURANT_ID}}' required>{{this.NAME}}</option>
        {{/each}}
    </select>
    <input type='submit' />
</form>

</br><br/>
{{! UPDATE form }}
{{! FOOD_ITEM needs the following fields in order to update: FOOD_ITEM_ID, RESTAURANT_ID, NAME (name of the food), and a PRICE }}
<h2>Update a Food Item</h2>
<form class='cuForm' id='update_food_item_form' METHOD='POST' action='/food_items/update'>
    <label for='update_select_food_item'>Food Item to Update: </label>
    <select name='update_select_food_item' id='update_select_food_item' required>
        <option value='' disabled selected>Select a Food Item</option>
        {{#each food_rest}}
        <option value='{{this.FOOD_ITEM_ID}}{{this.RESTAURANT_ID}}' required>
            {{this.FOOD_ITEM_ID}}: {{this.NAME}} - {{this.R_NAME}}
        </option>
        {{/each}}
    </select>

    <br/>

    <label for='update_food_item_name'>Name: </label>
    <input type="text" name='update_food_item_name' id='update_food_item_name' value='{{update_select_food_item_id}}'>

    <label for='update_food_item_restaurant_id'>Restaurant: </label>
    <select name='update_food_item_restaurant_id' id='update_food_item_restaurant_id'>
        <option value='NULL' disabled selected>Select a Restaurant</option>
        {{#each restaurant}}
            <option value='{{this.RESTAURANT_ID}}' required>
                {{this.NAME}}
            </option>
        {{/each}}
    </select>

    <label for='update_food_item_price'>Price: </label>

    <!-- Citation for the step field in the following control. Date: 2/15/2026
         Developed with reference to:
         Source URL: https://amydegregorio.com/2017/11/22/html5-number-input-the-step-attribute/ -->
    <input type='number' step=".001" name='update_food_item_price' id='update_food_item_price' min='.01' />

    <input type='submit' />
</form>