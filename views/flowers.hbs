<h1>Flowers</h1>

{{! READ table }}
<table>
    <thead>
    {{! HEADERS }}
    <tr>
        {{#each flower.[0]}}
            <th>
                {{@key}}
            </th>
        {{/each}}
        <th></th>
        <th></th>
    </tr>
    </thead>

    <tbody>

    {{! ADD FLOWER form }}
    <form class='cuForm' id='create_flower_form' METHOD='POST' action='/flowers/create'>
        <tr>
            <td>Add New</td>
            <td><input type='text' name='create_flower_name' id='create_flower_name' required/></td>
            <td><input type='text' name='create_flower_meaning' id='create_flower_meaning' required/></td>
            <td><select name='create_color_id' id='create_color_id' required>
                <option value='NULL' disabled selected>Select a Color</option>
                {{#each color}}
                    <option value='{{this.COLOR_ID}}'>{{this.COLOR}}</option>
                {{/each}}
            </select></td>
            <td colspan="2"><input type='submit' value="Add New Flower"/></td>
        </tr>
    </form>

    {{! FIELDS }}
    {{#each flower}}
        <tr>
            <td>{{this.FLOWER_ID}}</td>
            <td>{{this.NAME}}</td>
            <td>{{this.MEANING}}</td>
            <td>{{this.COLOR}}</td>

            {{! UPDATE form }}
            <form id='update_flower_form' METHOD='POST' action='/flower_edit'>
                <input type='hidden' name='update_flower_id' value='{{this.FLOWER_ID}}'/>
                <input type='hidden' name='update_flower_name' value='{{this.NAME}}'/>
                <input type='hidden' name='update_flower_meaning' value='{{this.MEANING}}'/>
                <input type='hidden' name='update_flower_color' value='{{this.COLOR}}'/>
                <td>
                    <button type='submit'>
                        Edit
                    </button>
                </td>
            </form>

            {{! DELETE form }}
            <form id='delete_flower_form' METHOD='POST' action='/flowers/delete'>
                <input type='hidden' name='delete_flower_id' value='{{this.FLOWER_ID}}'/>
                <input type='hidden' name='delete_flower_name' value='{{this.NAME}}'/>
                <td>
                    <button type='submit'>
                        Delete
                    </button>
                </td>
            </form>
        </tr>
    {{/each}}
    </tbody>
</table>
